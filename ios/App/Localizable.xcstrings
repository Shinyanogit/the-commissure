    "colophon.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Commissure is a focused anatomy-learning theater. It presents versioned educational content with a calm, offline-first interface." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "The Commissureは、解剖学習に集中するためのシアターです。バージョン管理された教育コンテンツを、オフライン優先の落ち着いた画面で提示します。" } }
      }
    },
    "colophon.disclaimer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Educational use only. This app does not provide medical advice or replace supervised training." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "教育目的に限ります。このアプリは医療助言を提供せず、指導下のトレーニングに代わるものではありません。" } }
      }
    },
    "colophon.title" : {
