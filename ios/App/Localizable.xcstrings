    "app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Commissure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "The Commissure"
          }
        }
      }
    },
    "colophon.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are a group of medical students dedicated to improving the lives of patients suffering from spinal disorders. We created The Commissure to provide accurate, accessible and visually engaging information about spine surgery for healthcare professionals, patients and the general public."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私たちは、脊椎疾患をもつ患者さんの生活の改善を目指す医学生のグループです。医療従事者、患者さん、一般の方々に向けて、脊椎外科について正確でわかりやすく、視覚的に理解できる情報を届けるため、The Commissureを制作しました。"
          }
        }
      }
    },
    "colophon.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Educational use only. This app does not provide medical advice or replace supervised training."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教育目的に限ります。このアプリは医療助言を提供せず、指導下のトレーニングに代わるものではありません。"
          }
        }
      }
    },
    "colophon.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About The Commissure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "The Commissureについて"
          }
        }
      }
    },
