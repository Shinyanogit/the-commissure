{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecommissure.app/schema/catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "publishedAt", "procedures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "procedures": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "revision", "sceneSchemaVersion", "minimumAppBuild", "locales", "requiredCapabilities", "files", "provenanceId"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "revision": { "type": "integer", "minimum": 1 },
          "sceneSchemaVersion": { "const": 1 },
          "minimumAppBuild": { "type": "integer", "minimum": 1 },
          "locales": {
            "type": "array",
            "prefixItems": [{ "const": "en" }, { "const": "ja" }],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "requiredCapabilities": {
            "type": "array",
            "items": { "enum": ["absoluteSceneState", "restrictedMarkdown", "bilingualV1"] },
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true
          },
          "files": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "path", "sha256", "bytes"],
              "properties": {
                "role": { "enum": ["procedure", "scene", "localization-en", "localization-ja", "provenance"] },
                "path": { "type": "string", "pattern": "^content/(procedures|ios-scenes)/.+\\.json$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "provenanceId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
