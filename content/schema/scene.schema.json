{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecommissure.app/schema/scene-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "procedureId", "assetId", "assetVersion", "rootEntityPath", "parts", "baseState", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "procedureId": { "$ref": "#/$defs/id" },
    "assetId": { "$ref": "#/$defs/id" },
    "assetVersion": { "$ref": "#/$defs/semver" },
    "rootEntityPath": { "type": "string", "pattern": "^/root/procedure_[a-z][a-z0-9_]*$" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceEntity", "entityPath", "dynamic"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "sourceEntity": { "type": "string", "minLength": 1 },
          "entityPath": { "type": "string", "pattern": "^/root/procedure_[a-z][a-z0-9_]*/(anatomy|implants)/[a-z][a-z0-9_]*$" },
          "dynamic": { "type": "boolean" },
          "implantId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "baseState": { "$ref": "#/$defs/state" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "viewPolicy", "state", "entrance"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "viewPolicy": { "enum": ["preserveAdjustment", "reframe"] },
          "state": { "$ref": "#/$defs/state" },
          "entrance": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["duration", "easing", "target"],
              "properties": {
                "duration": { "type": "number", "minimum": 0, "maximum": 3 },
                "easing": { "enum": ["linear", "easeInOut"] },
                "target": { "$ref": "#/$defs/state" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "vector": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "up", "fieldOfView"],
      "properties": {
        "position": { "$ref": "#/$defs/vector" },
        "target": { "$ref": "#/$defs/vector" },
        "up": { "$ref": "#/$defs/vector" },
        "fieldOfView": { "type": "number", "exclusiveMinimum": 1, "exclusiveMaximum": 120 }
      }
    },
    "partState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "rotation", "opacity", "isVisible"],
      "properties": {
        "translation": { "$ref": "#/$defs/vector" },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["axis", "radians"],
          "properties": {
            "axis": { "$ref": "#/$defs/vector" },
            "radians": { "type": "number", "minimum": -6.283186, "maximum": 6.283186 }
          }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "isVisible": { "type": "boolean" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "parts"],
      "properties": {
        "camera": { "$ref": "#/$defs/camera" },
        "parts": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/partState" }
        }
      }
    }
  }
}
